{
  "name": "AuditTrail - Log Critical Operations",
  "type": "PostToolUse",
  "description": "Logs all critical operations for audit and debugging purposes",
  "enabled": true,
  "logConfig": {
    "directory": ".github/logs",
    "format": "json",
    "retention": "30 days",
    "logLevel": "DEBUG"
  },
  "rules": [
    {
      "id": "audit-file-deletions",
      "action": "LOG",
      "condition": "tool == 'run_in_terminal' && command.includes('rm ')",
      "logFields": ["timestamp", "command", "workingDirectory", "exitCode", "output"],
      "severity": "HIGH"
    },
    {
      "id": "audit-database-changes",
      "action": "LOG",
      "condition": "tool == 'run_in_terminal' && (command.includes('INSERT') || command.includes('UPDATE') || command.includes('DELETE'))",
      "logFields": ["timestamp", "query", "affectedRows", "executionTime"],
      "severity": "HIGH"
    },
    {
      "id": "audit-email-campaigns",
      "action": "LOG",
      "condition": "tool matches 'gmail_sender' && method == 'send'",
      "logFields": ["timestamp", "recipientCount", "templateUsed", "campaignId", "status"],
      "severity": "CRITICAL"
    },
    {
      "id": "audit-config-changes",
      "action": "LOG",
      "condition": "fileEdited in ['config.py', 'pipeline.json', 'pipeline_db.py']",
      "logFields": ["timestamp", "filePath", "changedLines", "changeType", "author"],
      "severity": "HIGH"
    },
    {
      "id": "audit-failed-operations",
      "action": "LOG",
      "condition": "exitCode != 0 || error != null",
      "logFields": ["timestamp", "operation", "errorMessage", "severity"],
      "severity": "MEDIUM"
    }
  ]
}
